# Build from the repository root so the proto module is in context.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY proto/go.mod proto/go.sum ./proto/
COPY server/go.mod server/go.sum ./server/
RUN go work init ./proto ./server
WORKDIR /src/server
RUN go mod download
WORKDIR /src
COPY proto/ ./proto/
COPY server/ ./server/
WORKDIR /src/server
RUN CGO_ENABLED=0 go build -trimpath -o /out/keyref-server ./cmd/keyref-server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/keyref-server /keyref-server
ENV KEYREF_VERCEL=1
EXPOSE 80
USER nonroot:nonroot
ENTRYPOINT ["/keyref-server"]
