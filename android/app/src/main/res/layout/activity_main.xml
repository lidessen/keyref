<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F3F4"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="① 授权读取短信" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② 加入电池优化白名单" />

        <LinearLayout
            android:id="@+id/pairingBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 配对到 keyref 保险库"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/originInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="服务器地址，如 https://keys.example.com"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生成配对二维码（用 iPhone 扫）" />

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="采集设置（只上传命中规则的验证码短信）"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="发信号码白名单（设计与 §14.2：规则仅存本机）" />

            <TextView
                android:id="@+id/sendersText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textIsSelectable="true" />

            <EditText
                android:id="@+id/senderInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="发信号码，如 10086"
                android:inputType="phone"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnAddSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="添加发信号码" />

            <Button
                android:id="@+id/btnToggleCollect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开启 / 关闭采集" />

            <Button
                android:id="@+id/btnUnpair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="解除配对（清空本机配对状态）" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="日志" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
